# ==============================================================================
# VaultIQ Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (used for CORS configuration)
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (must be an explicit URI, e.g. local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/vaultiq

# JWT Secret Key (use a minimum 32-character random string in production)
JWT_SECRET=super_secret_enterprise_jwt_key_replace_in_production_32chars!

# JWT Token Expiration (e.g., '1d', '7d', '24h')
JWT_EXPIRES_IN=7d

# API Version Prefix
API_VERSION=v1

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Document Processing Configuration (Phase 3)
MAX_EXTRACTED_TEXT_SIZE_MB=10

# Semantic & Vector Search Configuration (Phase 4)
# Embedding Provider: 'openai' (production) or 'mock' (tests / offline dev)
EMBEDDING_PROVIDER=openai
# OpenAI API Key (required when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=50
# Chunking size and overlap in characters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_SEARCH_RESULTS=50
# Vector Search Engine: 'atlas' (MongoDB Atlas Vector Search) or 'local' (In-memory cosine calculation)
VECTOR_SEARCH_ENGINE=local

# ==============================================================================
# RAG & AI Assistant Configuration (Phase 5)
# ==============================================================================
# LLM Provider: 'openai' (production) or 'mock' (offline tests / development)
LLM_PROVIDER=openai
# OpenAI API Key (required when LLM_PROVIDER=openai; can reuse OPENAI_API_KEY from above)
# OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1000

# RAG Retrieval & Context Bounds
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.5
RAG_MAX_CONTEXT_CHARS=6000

# Chat & Conversation Bounds
CHAT_HISTORY_LIMIT=10
CHAT_MAX_MESSAGE_LENGTH=2000
